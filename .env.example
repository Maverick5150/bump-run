# Copy to .env and fill in for your environment. Never commit the real .env file.

PORT=3000
HOST=0.0.0.0

# Must be an address phones and the Fire TV can actually reach -- never leave
# this as localhost in production. For LAN development, use scripts/dev-lan.mjs
# instead of setting this by hand.
PUBLIC_BASE_URL=http://localhost:3000

# Restrict to your controller's real origin in production; "*" is fine for
# local development only.
CORS_ORIGIN=*

NODE_ENV=development
